APP_NAME="Engage SEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Select one clients/[CLIENT_KEY] directory.
# Leave blank for the generic platform state.
CLIENT_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

################################
# LOGGING
################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################
# DATABASE / PROCESS CONNECTION
################################

# Database identity and credentials belong in the selected client .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

################################
# CACHE
################################

CACHE_STORE=database

################################
# SESSIONS
################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

################################
# QUEUES
################################

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

################################
# REDIS
################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

################################
# MAIL / BROADCASTING
################################

MAIL_MAILER=log
BROADCAST_CONNECTION=log

################################
# LOCAL DESTRUCTIVE OPERATIONS
################################

# Must be true, in addition to APP_ENV=local, before the Engage SEO
# reset/refresh scripts will wipe the selected client database.
DEV_DESTRUCTIVE_COMMANDS_ENABLED=false

################################
# FRONTEND
################################

VITE_APP_NAME="${APP_NAME}"