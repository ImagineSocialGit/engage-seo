APP_NAME="Engage SEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

################################
# ACTIVE CLIENT
################################

# The sole client selector.
#
# Changing this value selects:
#   clients/[CLIENT_KEY]/.env
#   clients/[CLIENT_KEY]/config/**
#
# Client URL, database identity/credentials, client namespaces, stable client
# timezone, vertical, enabled Features, and future client integration values do
# not belong in this root environment file.
CLIENT_KEY=

################################
# LOCALE
################################

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

################################
# APPLICATION / PROCESS
################################

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

################################
# LOGGING
################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################
# DATABASE INFRASTRUCTURE
################################

# Client-owned database identity and credentials belong in:
#   clients/[CLIENT_KEY]/.env
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

################################
# CACHE INFRASTRUCTURE
################################

CACHE_STORE=database

# CACHE_PREFIX is client-owned.

################################
# SESSIONS
################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# SESSION_DOMAIN is client-owned.

################################
# QUEUES
################################

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

################################
# REDIS INFRASTRUCTURE
################################

# REDIS_PREFIX is client-owned.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

################################
# FILESYSTEM TRANSPORT
################################

# Provider credentials/buckets remain undefined until a reusable storage seam
# is added. The transport/driver choice is process-owned.
FILESYSTEM_DISK=local

################################
# MAIL / BROADCASTING
################################

MAIL_MAILER=log
BROADCAST_CONNECTION=log

################################
# LOCAL DESTRUCTIVE OPERATIONS
################################

# Must be true, in addition to APP_ENV=local, before the Engage SEO
# reset/refresh scripts will wipe the selected client database.
DEV_DESTRUCTIVE_COMMANDS_ENABLED=false

################################
# FRONTEND
################################

VITE_APP_NAME="${APP_NAME}"