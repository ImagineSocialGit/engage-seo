# Engage SEO automated-test runtime
#
# Copy this file to:
#
#   .env.testing
#
# Laravel loads .env.testing instead of the normal root .env while PHPUnit /
# `php artisan test` runs.
#
# This is a platform test runtime, not a selected-client deployment environment.
# Never point it at a real client, staging, or production database.

APP_NAME="Engage SEO"
APP_ENV=testing
APP_KEY=base64:ZW5nYWdlLXNlby10ZXN0LWtleS0zMi1ieXRlcyEhISE=
APP_DEBUG=true

# Automated tests always run in the generic platform state.
CLIENT_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

################################
# MYSQL TEST DATABASE
################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# REQUIRED: populate these with a dedicated disposable MySQL test database.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Required safety acknowledgement. Database-backed tests refuse to run unless
# this resolves to true.
ENGAGE_SEO_TEST_DATABASE=true

################################
# IN-MEMORY / NON-PERSISTENT TEST SERVICES
################################

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null